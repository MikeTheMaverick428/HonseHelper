# Copy this file to .env and keep it local (not committed to repo)
# Test account ID for API tests (replace with your own if needed)
TEST_ACCOUNT_ID=100000000000

# Circle ID to test circle endpoints (e.g. circle get, rank thresholds)
# Replace with a valid circle ID from the API
TEST_CIRCLE_ID=100000000

# API key for uma.moe API
UMA_MOE_API_KEY=your_api_key_here
